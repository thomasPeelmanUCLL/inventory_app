{
    "name": "secure-inventory-api",
    "version": "2.0.0",
    "description": "Secure Inventory Management API with multi-tenant authorization",
    "author": "thomasPeelmanUCLL",
    "license": "ISC",
    "main": "app.ts",
    "prisma": {
        "schema": "repository/prisma/schema.prisma"
    },
    "scripts": {
        "test": "jest",
        "start": "nodemon -L app.ts --delay 3",
        "prisma:migrate": "prisma migrate deploy",
        "prisma:generate": "prisma generate",
        "prisma:studio": "prisma studio",
        "setup:db": "node setup-database.js",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix"
    },
    "nodemonConfig": {
        "ext": "ts",
        "delay": "3",
        "execMap": {
            "ts": "ts-node"
        }
    },
    "dependencies": {
        "@prisma/client": "^5.1.1",
        "bcrypt": "^5.1.0",
        "bcryptjs": "^2.4.3",
        "better-auth": "^1.3.29",
        "body-parser": "^1.20.1",
        "cors": "^2.8.0",
        "date-fns": "^2.30.0",
        "dotenv": "^16.0.0",
        "express": "^4.18.0",
        "express-jwt": "^8.5.1",
        "express-rate-limit": "^7.1.5",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "swagger-jsdoc": "^6.2.0",
        "swagger-ui-express": "^4.6.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/body-parser": "^1.19.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.0",
        "@types/jest": "^29.5.13",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^18.0.0",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.6",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.45.0",
        "jest": "^29.7.0",
        "nodemon": "^2.0.0",
        "prisma": "^5.1.1",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.0",
        "typescript": "^5.9.3"
    },
    "keywords": [
        "inventory",
        "management",
        "api",
        "secure",
        "multi-tenant",
        "authorization",
        "typescript",
        "prisma",
        "express"
    ]
}
